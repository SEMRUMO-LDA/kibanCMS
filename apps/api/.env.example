# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Configuration
PORT=5001
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5176

# Email (Resend) — REQUIRED for form notifications, booking/order emails,
# newsletter welcome emails. Shared by all tenants. Without RESEND_API_KEY
# no email is sent (the API logs "Email NOT sent: RESEND_API_KEY is not set").
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend
DEFAULT_FROM_EMAIL=noreply@kiban.pt
DEFAULT_FROM_NAME=KibanCMS
# Fallback recipients when a tenant has no "Notification Email(s)" / "Contact Email" in Settings
NOTIFICATION_EMAIL=

# Multi-tenant (production). JSON array of tenants; when unset the three
# SUPABASE_* vars above act as the single default tenant.
# See docs/MULTI_TENANT_GUIDE.md for the exact shape.
# TENANTS=[{"id":"lunes","supabaseUrl":"...","supabaseAnonKey":"...","supabaseServiceRoleKey":"...","origins":["https://lunes.pt"]}]

# Stripe fallback for single-tenant setups (tenants normally keep their keys in
# Content → Stripe Config). Webhook secret comes from the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=eur

# Optional
REDIS_URL=                 # cache fallback; the API works without it
PREVIEW_SECRET=            # HMAC secret for draft preview links (random 32+ chars)
GEMINI_API_KEY=            # AI content/collection generation
META_GRAPH_VERSION=v21.0   # Meta Conversions API version
