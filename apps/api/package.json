{
  "name": "@kiban/api",
  "version": "1.6.0",
  "description": "KibanCMS Unified Server (API + Admin)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm build:api && pnpm build:admin",
    "build:api": "tsc",
    "build:admin": "cd ../admin && pnpm build",
    "start": "NODE_ENV=production node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test src/__tests__/security.test.ts src/__tests__/site-health.test.ts src/__tests__/translation-cache.test.ts src/__tests__/sitemap.test.ts src/__tests__/spam-protection.test.ts src/__tests__/booking-capacity.test.ts src/__tests__/booking-reminders.test.ts src/__tests__/image-optimizer.test.ts src/__tests__/ai-visibility.test.ts src/__tests__/meta-capi.test.ts src/__tests__/marketing.test.ts src/__tests__/review-fixes.test.ts",
    "test:smoke": "node --import tsx --test src/__tests__/smoke.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.39.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "multer": "^2.5.0",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
